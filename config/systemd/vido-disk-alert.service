[Unit]
Description=VIDO disk usage email alert
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/vido/disk-alert.env
ExecStart=/usr/bin/python3 /usr/local/lib/vido/vido_disk_alert.py --path / --path /data
User=root
Group=root
PrivateTmp=true
NoNewPrivileges=true

