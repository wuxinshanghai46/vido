{
  "name": "vido-ai-platform",
  "version": "1.0.0",
  "description": "AI Video Generation Platform with auto story writing",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node scripts/db/run-migrations.js",
    "db:migrate:dry": "node scripts/db/run-migrations.js --dry-run",
    "db:verify-schema": "node scripts/db/verify-schema.js",
    "db:import-json": "node scripts/db/migrate-json-to-sqlite.js",
    "db:import-json:dry": "node scripts/db/migrate-json-to-sqlite.js --dry-run",
    "db:verify-json": "node scripts/db/verify-json-migration.js"
    ,"video-canvas:worker": "node src/workers/videoCanvas/worker.js",
    "video-canvas:migrate:dry": "node scripts/migrate-video-canvas-v1.js",
    "video-canvas:migrate": "node scripts/migrate-video-canvas-v1.js --apply",
    "video-canvas:boundaries": "node scripts/check-video-canvas-boundaries.js",
    "video-canvas:test": "node scripts/test-video-canvas-v2.js",
    "story-ad:v3:boundaries": "node scripts/check-new-story-ad-v3-boundaries.js",
    "story-ad:v3:test": "node scripts/test-video-generation-core-v3.js && node scripts/check-new-story-ad-v3-boundaries.js && node scripts/test-new-story-ad-person-assist-completeness.js && node scripts/test-new-story-ad-verification-lifecycle.js && node scripts/test-new-story-ad-video-preflight.js && node scripts/test-new-story-ad-scene-block-video.js && node scripts/test-new-story-ad-video-orchestration.js"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.47.1",
    "pdf-parse": "^1.1.4",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "^24.40.0",
    "sharp": "^0.32.6",
    "ssh2": "^1.17.0",
    "uuid": "^9.0.0",
    "vue": "^3.5.38",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
